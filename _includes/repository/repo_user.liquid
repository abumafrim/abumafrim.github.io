<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" title="{{ include.username }} on GitHub">
    <img
      class="rounded-circle z-depth-1"
      style="width: 110px; height: 110px; object-fit: cover;"
      alt="{{ include.username }}"
      src="https://github.com/{{ include.username }}.png?size=220"
    >
    <div class="mt-2"><strong>@{{ include.username }}</strong></div>
  </a>
</div>
