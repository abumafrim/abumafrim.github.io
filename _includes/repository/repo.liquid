{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<a class="repo-card" href="https://github.com/{{ include.repository }}" title="{{ include.repository }} on GitHub">
  <span class="repo-card-icon"><i class="fa-brands fa-github"></i></span>
  <span class="repo-card-name">
    {% if show_owner %}<span class="repo-owner">{{ repo_url[0] }}/</span>{% endif %}<strong>{{ repo_url[1] }}</strong>
  </span>
</a>
