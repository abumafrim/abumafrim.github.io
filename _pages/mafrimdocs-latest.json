{%- assign app = site.data.apps.apps | where: 'feed', true | first -%}
{%- assign latest = app.history | first -%}
{
  "version": {{ latest.version | jsonify }},
  "notes": {{ latest.notes | strip | jsonify }},
  "url": {{ app.page | jsonify }},
  "date": {{ latest.date | jsonify }}
}
